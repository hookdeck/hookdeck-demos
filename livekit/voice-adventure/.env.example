# LiveKit Cloud project credentials (REQUIRED)
# LiveKit Cloud dashboard: Settings -> API keys (https://cloud.livekit.io/projects/p_/settings/keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Hookdeck project API key (REQUIRED)
# Hookdeck dashboard: Project settings -> API keys. `npm run setup` creates the
# connection in this project with the Hookdeck API. `npm run listen` forwards its
# source with the Hookdeck CLI, using a config file of its own, so your interactive
# `hookdeck login` is untouched.
HOOKDECK_API_KEY=your_hookdeck_api_key_here

# Hookdeck project signing secret (REQUIRED)
# Hookdeck dashboard: Project settings -> Secrets, https://dashboard.hookdeck.com/settings/project/secrets.
# The app verifies the x-hookdeck-signature header on every delivery with it, and answers 401 when it
# is missing or wrong. The API key cannot read it, so copy it here by hand.
HOOKDECK_SIGNING_SECRET=your_hookdeck_signing_secret_here

# Server port (optional), and the address it listens on. The default 127.0.0.1 keeps it local; 0.0.0.0 opens it to your network.
PORT=4000
# HOST=127.0.0.1
# Most story rooms and Pixel bots that can run at once (optional)
# MAX_ROOMS=6
# MAX_PIXELS=4

# Optional settings
# Where the agent reaches the app (default http://localhost:<PORT>), and the agent's registered name (default story-gm)
# STORY_APP_URL=http://localhost:4000
# STORY_AGENT_NAME=story-gm
# Start the story somewhere else, for a quick test: STORY_START=cave
# STORY_START=
# Where the app keeps its data (default data/)
# DATA_DIR=
# LiveKit Cloud project to put the webhook in, if LIVEKIT_URL doesn't pick one (`npm run setup`)
# LIVEKIT_PROJECT_ID=
# A LiveKit Cloud session token, instead of `lk cloud auth --user-auth` (`npm run setup`)
# LIVEKIT_SESSION_TOKEN=
# Path to a Hookdeck CLI binary (default: the hookdeck-cli npm dependency)
# HOOKDECK_CLI=

# Written by `npm run setup`: paste this URL into LiveKit Cloud -> Settings -> Webhooks
LIVEKIT_WEBHOOK_URL=https://hkdk.events/your-source-id-here

# Soundtracks (optional): LiveKit Cloud fetches them, so the URL must be public.
# Default: this folder on the repository's main branch. Host the files yourself with:
# SOUNDTRACK_BASE_URL=https://example.com/soundtracks
# One scene only: SOUNDTRACK_URL_TAVERN, SOUNDTRACK_URL_FOREST, SOUNDTRACK_URL_CAVE or SOUNDTRACK_URL_FINALE
# SOUNDTRACK_URL_CAVE=https://example.com/cave.ogg
