{
  "name": "hookdeck-livekit-voice-adventure",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "npm run build:scenes && ts-node src/server.ts",
    "setup": "ts-node scripts/setup-hookdeck.ts",
    "listen": "ts-node scripts/listen.ts",
    "activity": "bash scripts/activity.sh",
    "simulate": "ts-node scripts/simulate.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --require ts-node/register --test test/*.test.ts",
    "build:scenes": "node scripts/build-scenes.mjs",
    "capture": "ts-node scenes/kit/capture/capture.ts",
    "agent": "npm install --prefix agent --no-audit --no-fund --silent && npm start --prefix agent"
  },
  "description": "Hookdeck + LiveKit: a multiplayer voice adventure (story night) whose room events are recorded from webhooks delivered through Event Gateway",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "hookdeck-cli": "3.2.0",
    "livekit-server-sdk": "2.19.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@material-symbols/svg-400": "0.47.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "esbuild": "0.25.9",
    "gsap": "3.15.0",
    "playwright": "1.55.0"
  },
  "engines": {
    "node": ">=22"
  }
}
