# A project API key for a DEDICATED Hookdeck Event Gateway test project.
# Project settings -> API keys -> API key. The agent creates one MCP Events
# source and one connection per subscription in this project, and deletes
# them when it unsubscribes, so don't point it at a project you use for anything else.
HOOKDECK_API_KEY=

# Public HTTPS base URL that reaches the agent's HTTP endpoint. Setting it switches
# delivery from `hookdeck listen` to HTTP. Use the deployed agent's URL.
# AGENT_PUBLIC_URL=https://agent.example.com

# Optional. Local ports. Defaults: sender 3100, agent 3200.
# SENDER_PORT=3100
# AGENT_PORT=3200

# Optional. A different Hookdeck CLI binary for `hookdeck listen`,
# for example a local build. Defaults to the hookdeck-cli npm dependency.
# HOOKDECK_CLI=/path/to/hookdeck

# Optional. Defaults to https://api.hookdeck.com/2026-09-01
# HOOKDECK_API_BASE=https://api.hookdeck.com/2026-09-01
