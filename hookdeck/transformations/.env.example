# A project API key for a DEDICATED Hookdeck Event Gateway test project.
# Project settings -> API keys -> API key. Setup creates a source, transformation
# and connection per example, and the demo calls `hookdeck ci --api-key` with
# this, so it never touches whatever project you are logged into interactively.
HOOKDECK_API_KEY=

# Optional. The secret the sign-hmac transformation signs with, and this server
# verifies with. Defaults to demo_webhook_secret.
# HOOKDECK_WEBHOOK_SECRET=

# Optional. A different Hookdeck CLI binary to run `listen` with, e.g. a local build.
# HOOKDECK_CLI=/path/to/hookdeck

# Optional. Defaults to https://api.hookdeck.com/2026-09-01
# HOOKDECK_API_BASE=https://api.hookdeck.com/2026-09-01

# Optional. Local port for the receiver and UI. Defaults to 4400.
# PORT=4400
