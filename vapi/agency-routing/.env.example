# Vapi private API key (REQUIRED)
# Vapi dashboard: https://dashboard.vapi.ai/org/api-keys -> Private API Key.
# `npm run setup` uses it to create the HMAC credential, the async tool and one assistant per client.
VAPI_API_KEY=your_vapi_private_api_key_here

# Vapi public key (REQUIRED for the Start call buttons)
# Vapi dashboard: https://dashboard.vapi.ai/org/api-keys -> Public Key (not the private one).
# The page uses it with the Vapi Web SDK to start calls from the browser.
VAPI_PUBLIC_KEY=your_vapi_public_key_here

# Hookdeck project API key (REQUIRED)
# Hookdeck dashboard: Project settings -> API keys. `npm run setup` creates the
# sources and connections in this project and `npm run listen` forwards them, using
# a CLI config file of their own, so your interactive `hookdeck login` is untouched.
HOOKDECK_API_KEY=your_hookdeck_api_key_here

# Server port (optional)
PORT=4000

# How the app gives a background result to the live call: add-message (default) or say
# CONTROL_MODE=add-message

# How long the simulated CRM lookup takes, in milliseconds (optional)
# LOOKUP_DELAY_MS=6000

# Written by `npm run setup`
VAPI_WEBHOOK_SECRET=
VAPI_HMAC_CREDENTIAL_ID=
VAPI_TOOL_ID=
ACME_SOURCE_URL=
ACME_ASSISTANT_ID=
GLOBEX_SOURCE_URL=
GLOBEX_ASSISTANT_ID=
