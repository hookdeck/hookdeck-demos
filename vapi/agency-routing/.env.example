# Vapi private API key (REQUIRED)
# Vapi dashboard: https://dashboard.vapi.ai/org/api-keys -> Private API Key.
# `npm run setup` uses it to create the HMAC credential, the async tool and one assistant per client.
VAPI_API_KEY=your_vapi_private_api_key_here

# Vapi public key (REQUIRED for the Start call buttons)
# Vapi dashboard: https://dashboard.vapi.ai/org/api-keys -> Public Key (not the private one).
# The page uses it with the Vapi Web SDK to start calls from the browser.
VAPI_PUBLIC_KEY=your_vapi_public_key_here

# Hookdeck project API key (REQUIRED)
# Hookdeck dashboard: Project settings -> Secrets (https://dashboard.hookdeck.com/settings/project/secrets). `npm run setup` creates the
# sources and connections in this project with the Hookdeck API. `npm run listen`
# forwards them with the Hookdeck CLI, using a config file of its own, so your
# interactive `hookdeck login` is untouched.
HOOKDECK_API_KEY=your_hookdeck_api_key_here

# Hookdeck project signing secret (REQUIRED)
# Hookdeck dashboard: Project settings -> Secrets, https://dashboard.hookdeck.com/settings/project/secrets.
# The app verifies the x-hookdeck-signature header on every delivery with it, and answers 401 when it
# is missing or wrong. The API key cannot read it, so copy it here by hand.
HOOKDECK_SIGNING_SECRET=your_hookdeck_signing_secret_here

# Server port (optional)
PORT=4000

# Address the server binds to (optional). Loopback by default; `hookdeck listen` runs on this machine.
# Set HOST=0.0.0.0 only if you need the app reachable from the network.
# HOST=127.0.0.1

# Let the app post results to an http://localhost controlUrl (optional, off by default).
# Only `npm run simulate` needs this: it stands in for Vapi with a local server. Real controlUrls
# are https://*.vapi.ai and are the only other ones the app will call.
# ALLOW_LOCAL_CONTROL_URL=true

# How the app gives a background result to the live call: add-message (default) or say
# CONTROL_MODE=add-message

# How long the simulated CRM lookup takes, in milliseconds (optional)
# LOOKUP_DELAY_MS=6000

# Optional setup settings, read by `npm run setup`
# Model for the assistants (default gpt-4.1)
# VAPI_MODEL=gpt-4.1
# Have Vapi send "sha256=<hex>" instead of the bare hex digest as the signature
# VAPI_SIGNATURE_PREFIX=sha256=
# Have Event Gateway strip system prompts from payloads after verification
# TRIM_PAYLOAD=true
# Vapi API base URL (default https://api.vapi.ai)
# VAPI_API_BASE=https://api.vapi.ai
# Path to a Hookdeck CLI binary (default: the hookdeck-cli npm dependency)
# HOOKDECK_CLI=

# Written by `npm run setup`
VAPI_WEBHOOK_SECRET=
VAPI_HMAC_CREDENTIAL_ID=
VAPI_TOOL_ID=
ACME_SOURCE_URL=
ACME_ASSISTANT_ID=
GLOBEX_SOURCE_URL=
GLOBEX_ASSISTANT_ID=
