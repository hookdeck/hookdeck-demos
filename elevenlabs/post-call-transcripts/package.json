{
  "name": "hookdeck-elevenlabs-post-call-transcripts",
  "version": "1.0.0",
  "private": true,
  "description": "ElevenLabs post-call webhooks through Hookdeck: store and browse conversation transcripts, analysis and audio",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:scenes": "node scripts/build-scenes.mjs",
    "start": "npm run build:scenes && ts-node src/server.ts",
    "dev": "npm run build:scenes && ts-node src/server.ts",
    "setup": "ts-node scripts/setup.ts",
    "listen": "ts-node scripts/listen.ts",
    "call": "ts-node scripts/call.ts",
    "send": "ts-node scripts/send-sample.ts",
    "typecheck": "tsc --noEmit",
    "probe": "ts-node scripts/probe.ts",
    "test": "node --require ts-node/register --test test/*.test.ts",
    "capture": "ts-node scenes/kit/capture/capture.ts"
  },
  "license": "ISC",
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.77.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "hookdeck-cli": "3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@material-symbols/svg-400": "0.47.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "esbuild": "0.25.9",
    "gsap": "3.15.0",
    "playwright": "1.55.0"
  }
}
