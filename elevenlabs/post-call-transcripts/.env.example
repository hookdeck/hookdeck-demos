# ElevenLabs API key (REQUIRED)
# ElevenLabs dashboard: profile menu -> API keys (https://elevenlabs.io/app/settings/api-keys).
# Needs access to ElevenAgents (read and write), Webhooks and Workspace settings.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ID of the demo agent. Written by `npm run setup`, which creates and configures a dedicated
# agent named "Hookdeck demo: post-call transcripts"; leave it empty.
ELEVENLABS_AGENT_ID=

# Hookdeck project API key (REQUIRED)
# Hookdeck dashboard: Project settings -> API keys. `npm run setup` creates the
# connection in this project with the Hookdeck API. `npm run listen` forwards its
# source with the Hookdeck CLI, using a config file of its own, so your interactive
# `hookdeck login` is untouched.
HOOKDECK_API_KEY=your_hookdeck_api_key_here

# Hookdeck project signing secret (REQUIRED)
# Hookdeck dashboard: Project settings -> Secrets, https://dashboard.hookdeck.com/settings/project/secrets.
# The app verifies the x-hookdeck-signature header on every delivery with it, and answers 401 when it
# is missing or wrong. The API key cannot read it, so copy it here by hand.
HOOKDECK_SIGNING_SECRET=your_hookdeck_signing_secret_here

# Server port (optional)
PORT=4000

# Address the server binds to (optional). Loopback by default; `hookdeck listen` runs on this machine.
# Set HOST=0.0.0.0 only if you need the app reachable from the network, and list the name or IP
# you browse to in ALLOWED_HOSTS (comma-separated): requests with any other Host header get a 403.
# HOST=127.0.0.1
# ALLOWED_HOSTS=

# Path to a Hookdeck CLI binary (optional; default: the hookdeck-cli npm dependency)
# HOOKDECK_CLI=

# Written by `npm run setup`
# Hookdeck source URL that ElevenLabs sends post-call webhooks to
ELEVENLABS_WEBHOOK_URL=
# Signing secret of the ElevenLabs workspace webhook (also set on the Hookdeck source).
# Hookdeck verifies the ElevenLabs-Signature with it. The app does not check that header; this
# secret is also used by `npm run send` and `npm run probe` to sign sample requests.
ELEVENLABS_WEBHOOK_SECRET=
# ID of the ElevenLabs workspace webhook
ELEVENLABS_WEBHOOK_ID=
