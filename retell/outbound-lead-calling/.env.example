# Hookdeck project API key (REQUIRED)
# Hookdeck dashboard: Project settings -> API keys. `npm run setup` creates the
# connections in this project and `npm run listen` forwards its sources, using a
# CLI config file of its own, so your interactive `hookdeck login` is untouched.
HOOKDECK_API_KEY=your_hookdeck_api_key_here

# Retell API key (REQUIRED, server only: creates the agent, receives the webhook signature check)
# Retell dashboard: Settings -> API Keys. Used for the Retell API (setup, phone calls).
RETELL_API_KEY=your_retell_api_key_here

# The Retell API key with the webhook badge (Settings -> API Keys). Retell signs every
# webhook in the account with this one key, and `npm run setup` gives it to the Hookdeck
# source, which verifies x-retell-signature with it. Leave empty if it's RETELL_API_KEY.
RETELL_SECRET_KEY=

# Retell public key, for the browser web call (REQUIRED for "Start call in the browser")
# Retell dashboard: API Keys -> Public Keys -> create a key, add "localhost" to its allowed
# domains, copy the value (starts with public_key_). Safe to expose in the browser: Retell only
# accepts it from the domains you allow. Unlike RETELL_API_KEY, the app hands this one to the page.
RETELL_PUBLIC_KEY=your_retell_public_key_here

# OPTIONAL, phone calls only: a phone number you bought from (or imported to) Retell, E.164
# Retell dashboard: Phone Numbers (needs a payment method). This is the caller ID the lead sees.
RETELL_FROM_NUMBER=+14155550100

# OPTIONAL, phone calls only: the number the demo calls, in E.164 format
# Your own mobile. The form never asks for a number, so the app only ever dials this one.
TEST_LEAD_PHONE_NUMBER=+14155550101

# Optional: seconds between attempts on the retry ladder (a call nobody picks up is tried up to 3 times)
RETRY_DELAY_SECONDS=120

# Server port (optional)
PORT=4000

# Optional: the Retell voice for the agent `npm run setup` creates
RETELL_VOICE_ID=retell-Cimo

# Optional: also create a "run in background" custom function whose result the
# app injects into the live call. Set to true before `npm run setup`.
ENABLE_LIVE_INJECTION=false

# Written by `npm run setup` (see README.md)
RETELL_AGENT_ID=
RETELL_LLM_ID=
RETELL_EVENTS_URL=
RETELL_FUNCTION_URL=
