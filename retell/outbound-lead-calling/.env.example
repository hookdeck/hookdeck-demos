# Hookdeck project API key (REQUIRED)
# Hookdeck dashboard: Project settings -> API keys. `npm run setup` creates the
# connections in this project and `npm run listen` forwards its sources, using a
# CLI config file of its own, so your interactive `hookdeck login` is untouched.
HOOKDECK_API_KEY=your_hookdeck_api_key_here

# Retell API key (REQUIRED)
# Retell dashboard: API Keys. Use the key with the webhook badge: Retell signs
# every webhook with it, and Hookdeck verifies the signature with the same key.
RETELL_API_KEY=your_retell_api_key_here

# A phone number you bought from (or imported to) Retell, in E.164 format (REQUIRED)
# Retell dashboard: Phone Numbers. This is the caller ID the lead sees.
RETELL_FROM_NUMBER=+14155550100

# The number the demo calls, in E.164 format (REQUIRED)
# Your own mobile. The form never asks for a number, so the app only ever dials this one.
TEST_LEAD_PHONE_NUMBER=+14155550101

# Server port (optional)
PORT=4000

# Optional: the Retell voice for the agent `npm run setup` creates
RETELL_VOICE_ID=retell-Cimo

# Optional: also create a "run in background" custom function whose result the
# app injects into the live call. Set to true before `npm run setup`.
ENABLE_LIVE_INJECTION=false

# Written by `npm run setup` (see README.md)
RETELL_AGENT_ID=
RETELL_LLM_ID=
RETELL_EVENTS_URL=
RETELL_FUNCTION_URL=
