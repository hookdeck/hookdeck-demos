# Deepgram API Key (REQUIRED)
# Get your API key from https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Hookdeck project API key (REQUIRED)
# Hookdeck dashboard: Project settings -> API keys. `npm run setup` creates the
# connections in this project and `npm run listen` forwards its two sources, using
# a CLI config file of their own, so your interactive `hookdeck login` is untouched.
HOOKDECK_API_KEY=your_hookdeck_api_key_here

# Server port (optional)
PORT=4000

# Hookdeck Callback URLs (REQUIRED)
# Written by `npm run setup` (see README.md)

# TTS callback URL (for Text-to-Speech demo)
# Deepgram POSTs binary audio (audio/mpeg) to this URL
TTS_CALLBACK_URL=https://hkdk.events/your-tts-source-id-here

# STT callback URL (for Speech-to-Text demo)
# Deepgram POSTs JSON transcriptions to this URL
STT_CALLBACK_URL=https://hkdk.events/your-stt-source-id-here
